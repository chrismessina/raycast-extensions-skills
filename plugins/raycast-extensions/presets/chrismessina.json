  "judgments": [
    {
      "id": "prettierrc",
      "question": "Does the extension satisfy `prettierrc` (`.prettierrc` is this exact file, in every self-authored extension)?"
    },
    {
      "id": "no-any",
      "question": "Does the extension satisfy `no-any` (No `any` type casting)?"
    },
    {
      "id": "catch-unwrap",
      "question": "Does the extension satisfy `catch-unwrap` (Unwrap unknown catch values with the `instanceof Error` ternary)?"
    },
    {
      "id": "react-hooks-lint",
      "question": "Does the extension satisfy `react-hooks-lint` (`eslint-plugin-react-hooks` with `rules-of-hooks: error` is present)?"
    },
    {
      "id": "madge-cycles",
      "question": "Does the extension satisfy `madge-cycles` (`madge --circular` runs as a `pretest` gate)?"
    },
    {
      "id": "impeccable-off",
      "question": "Does the extension satisfy `impeccable-off` (Disable the Impeccable design hook — it is irrelevant to Raycast extensions)?"
    },
    {
      "id": "monotonic-elapsed",
      "question": "Does the extension satisfy `monotonic-elapsed` (An elapsed-time check uses `performance.now()`, never `Date.now()`)?"
    },
    {
      "id": "readiness-gate",
      "question": "Does the extension satisfy `readiness-gate` (A readiness gate tracks *did prep finish* and *which items succeeded* separately)?"
    },
    {
      "id": "cache-version-derived",
      "question": "Does the extension satisfy `cache-version-derived` (A cache version is DERIVED from the cached shape, never hand-maintained)?"
    },
    {
      "id": "interval-launchtype",
      "question": "Does the extension satisfy `interval-launchtype` (Interval-driven commands must branch on `environment.launchType`)?"
    },
    {
      "id": "ai-access",
      "question": "Does the extension satisfy `ai-access` (Handle no-AI-access on every Raycast-AI call)?"
    },
    {
      "id": "supportpath-internal",
      "question": "Does the extension satisfy `supportpath-internal` (`environment.supportPath` is for INTERNAL state only — user files go to a preference dir)?"
    },
    {
      "id": "selection-api",
      "question": "Does the extension satisfy `selection-api` (Read the active selection via the platform API, never a shell-out)?"
    },
    {
      "id": "launch-command-caught",
      "question": "Does the extension satisfy `launch-command-caught` (`launchCommand` is awaited inside a try/catch with a failure toast)?"
    },
    {
      "id": "copy-error",
      "question": "Does the extension satisfy `copy-error` (Every failure toast carries a \"Copy Error\" action)?"
    },
    {
      "id": "no-hud-before-actions",
      "question": "Does the extension satisfy `no-hud-before-actions` (In a `no-view` command, never `showHUD` before a toast that carries actions)?"
    },
    {
      "id": "animated-means-work",
      "question": "Does the extension satisfy `animated-means-work` (`Toast.Style.Animated` is a promise that work is in flight — never spin for a synchronous write)?"
    },
    {
      "id": "toast-no-id",
      "question": "Does the extension satisfy `toast-no-id` (A toast has no id — `hide()` and mutation act on whatever is on screen NOW)?"
    },
    {
      "id": "toast-window-copy",
      "question": "Does the extension satisfy `toast-window-copy` (Toast copy never says \"this window\" — a toast is a detached HUD)?"
    },
    {
      "id": "store-description",
      "question": "Does the changed `description` in `package.json` satisfy `store-description` (it leads with the action and the app people search for, names only what the commands and AI tools do, runs about 50 to 155 characters, has no shared filler, is one sentence ending with a period, and names a platform only when `platforms` matches)?"
    },
    {
      "id": "kit",
      "question": "Does the extension satisfy `kit` (Prefer `@chrismessina/raycast-kit` for failure toasts and count copy)?"
    },
    {
      "id": "show-in-finder",
      "question": "Does the extension satisfy `show-in-finder` (Show a file with `Action.ShowInFinder` / `showInFinder()`, never `open(path, \"Finder\")`)?"
    },
    {
      "id": "export-actions",
      "question": "Does the extension satisfy `export-actions` (A completed file export offers Show in Finder AND Copy Path, both with shortcuts)?"
    },
    {
      "id": "csv-formula-guard",
      "question": "Does the extension satisfy `csv-formula-guard` (A CSV export neutralizes spreadsheet formulas, not just quotes)?"
    },
    {
      "id": "first-action",
      "question": "Does the extension satisfy `first-action` (Audit the FIRST action of every ActionPanel state, not just the primary one)?"
    },
    {
      "id": "toggle-sidebar",
      "question": "Does the extension satisfy `toggle-sidebar` (Every `isShowingDetail` list carries a \"Show Sidebar\" / \"Hide Sidebar\" action)?"
    },
    {
      "id": "detail-code-lang",
      "question": "Does the extension satisfy `detail-code-lang` (A fenced code block in `Detail` markdown carries a language tag)?"
    },
    {
      "id": "empty-state-assets",
      "question": "Does the extension satisfy `empty-state-assets` (Empty-state assets are themed or vector)?"
    },
    {
      "id": "monochrome-icon",
      "question": "Does the extension satisfy `monochrome-icon` (A monochrome bundled icon needs a theme-aware treatment — a bare filename is invisible in one theme)?"
    },
    {
      "id": "no-tool-tags",
      "question": "Does the extension satisfy `no-tool-tags` (No agent-tool tags in shipped comments)?"
    },
    {
      "id": "us-english",
      "question": "Does the extension satisfy `us-english` (US English everywhere — UI copy, comments, docs, identifiers)?"
    },
    {
      "id": "empty-state-copy",
      "question": "Does the extension satisfy `empty-state-copy` (Empty/error state copy: short title, one-line description, steps in the actions)?"
    },
    {
      "id": "plural-copy",
      "question": "Does the extension satisfy `plural-copy` (Count-bearing copy uses correct singular/plural agreement — never `item(s)`)?"
    },
    {
      "id": "readme-preamble",
      "question": "Does the extension satisfy `readme-preamble` (Original extensions ship the social-badge preamble and `FUNDING.yml`)?"
    },
    {
      "id": "agents-md-claims",
      "question": "Does the extension satisfy `agents-md-claims` (AGENTS.md / CONCEPTS.md claims hold: named paths exist, npm scripts exist, no home-directory path, named symbols exist in src/)?"
    }
