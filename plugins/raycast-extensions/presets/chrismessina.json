    {
      "id": "logger",
      "title": "Structured logging via `@chrismessina/raycast-logger`",
      "anchor": "../reference/house-style.md#logger",
      "tag": "both",
      "applies": {
        "all": [
          {
            "selfAuthored": true
          },
          {
            "webRequests": true
          }
        ]
      },
      "severity": "block",
      "bindings": [
        {
          "kind": "rx",
          "check": "logger",
          "coverage": "full",
          "options": {
            "package": "@chrismessina/raycast-logger",
            "preference": "verboseLogging"
          }
        }
      ]
    },
    {
      "id": "logger-verbose-copy",
      "title": "The copy is fixed too — type this block verbatim",
      "anchor": "../reference/house-style.md#logger-verbose-copy",
      "tag": "both",
      "applies": {
        "declaresPreference": "verboseLogging"
      },
      "severity": "block",
      "bindings": [
        {
          "kind": "rx",
          "check": "logger-verbose-copy",
          "coverage": "full",
          "options": {
            "expected": {
              "name": "verboseLogging",
              "title": "Debug Logging",
              "label": "Enable extra diagnostics in the console",
              "description": "Show detailed logs in the console for debugging.",
              "type": "checkbox",
              "required": false,
              "default": false
            }
          }
        }
      ]
    },
    {
      "id": "logger-strict-redaction",
      "title": "Logger 1.5.0+: declare `strictRedaction` beside `verboseLogging`",
      "anchor": "../reference/house-style.md#logger-strict-redaction",
      "tag": "both",
      "applies": {
        "all": [
          {
            "selfAuthored": true
          },
          {
            "dependency": {
              "name": "@chrismessina/raycast-logger",
              "minVersion": "1.5.0"
            }
          }
        ]
      },
      "severity": "report",
      "bindings": [
        {
          "kind": "rx",
          "check": "logger-strict-redaction",
          "coverage": "full",
          "options": {
            "expected": {
              "name": "strictRedaction",
              "type": "checkbox",
              "required": false,
              "title": "Strict Redaction",
              "label": "Also hide URL query strings and fragments in logs",
              "description": "Turn on before reproducing an issue, then share only the new log lines.",
              "default": false
            }
          }
        }
      ]
    },
