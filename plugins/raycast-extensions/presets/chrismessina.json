{
  "schema": 1,
  "owner": "chrismessina",
  "rules": [
    {
      "id": "prettierrc",
      "title": "`.prettierrc` is this exact file, in every self-authored extension",
      "anchor": "../reference/house-style.md#prettierrc",
      "tag": "both",
      "applies": {
        "selfAuthored": true
      },
      "severity": "block",
      "bindings": [
        {
          "kind": "rx",
          "check": "prettierrc",
          "coverage": "partial",
          "options": {
            "printWidth": 120,
            "singleQuote": false,
            "sortImports": {
              "plugin": "@ianvs/prettier-plugin-sort-imports",
              "importOrder": [
                "<BUILTIN_MODULES>",
                "<THIRD_PARTY_MODULES>",
                "^@raycast/(.*)$",
                "^[.]"
              ]
            }
          }
        },
        {
          "kind": "judgment",
          "check": "prettierrc",
          "coverage": "partial"
        }
      ]
    },
    {
      "id": "no-hand-preferences",
      "title": "Never hand-define `Preferences` or `Arguments` types",
      "anchor": "../reference/house-style.md#no-hand-preferences",
      "tag": "lint",
      "applies": true,
      "severity": "report",
      "bindings": [
        {
          "kind": "rx",
          "check": "hand-typed-preferences",
          "coverage": "full"
        }
      ]
    },
    {
