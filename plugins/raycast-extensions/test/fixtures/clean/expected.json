    {
      "args": ["preflight", "--root", ".", "--json"],
      "match": "exact",
      "exit": 0,
      "checks": {
        "package-json": "PASS",
        "schema": "PASS",
        "categories": "PASS",
        "platforms": "PASS",
        "preference-type": "N/A",
        "shortcut-platform-case": "N/A",
        "changelog-exists": "PASS",
        "changelog-order": "PASS",
        "changelog-updated": "N/A",
        "command-renamed": "N/A",
        "eslint-config": "PASS",
        "lockfile": "PASS",
        "npm-registry": "PASS",
        "native-fetch": "PASS",
        "unused-dependencies": "PASS",
        "readme-assets": "PASS",
        "screenshots": "N/A",
        "launch-command": "PASS",
        "favicon": "PASS",
        "trash": "PASS",
        "localization": "PASS",
        "prettierrc": "PASS",
        "hand-typed-preferences": "PASS",
        "title-case": "PASS",
        "agent-scaffolding": "PASS",
        "dev-material": "PASS",
        "generated-files": "PASS",
        "screenshot-count": "N/A",
        "screenshot-format": "N/A",
        "screenshot-size": "N/A",
        "icon-size": "PASS",
        "readme-links": "PASS",
        "changelog-placeholder": "PASS",
        "nested-review-config": "PASS",
        "pref-description-length": "N/A",
        "pref-label-length": "N/A",
        "logger": "N/A",
        "logger-verbose-copy": "N/A",
        "logger-strict-redaction": "N/A",
        "agents-md-paths": "N/A",
        "agents-md-scripts": "N/A",
        "agents-md-no-home-paths": "N/A",
        "agents-md-symbols": "N/A"
      }
    }
  ]
}
